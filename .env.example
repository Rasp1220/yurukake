# YouTube Data API v3 key (server-side only)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Google Maps Platform key used server-side for Geocoding API
# https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
GOOGLE_MAPS_SERVER_API_KEY=

# Google Maps Platform key exposed to the browser for Maps JavaScript API / Directions
# Restrict this key to your site's HTTP referrers in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
