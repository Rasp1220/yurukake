# YouTube Data API v3 key (server-side only). サイト側のリクエストでは
# 使わず、`/api/cron/fetch-area-videos` バッチだけが呼ぶ。
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Supabase project settings (used for login and saving spots to the database)
# https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (optional) 動画プール（area_videos）の書き込みをサーバー限定にしたい場合のみ設定
# （Project Settings -> API -> service_role key）。絶対に公開しないこと。
SUPABASE_SERVICE_ROLE_KEY=

# `/api/cron/fetch-area-videos` を呼ぶときの認証トークン。GitHub Actions等の
# スケジューラから `Authorization: Bearer <この値>` で呼ぶ。自分で生成した
# ランダムな文字列を設定する（例: `openssl rand -hex 32`）。
CRON_SECRET=
