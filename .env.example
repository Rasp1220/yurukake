# YouTube Data API v3 key (server-side only)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Supabase project settings (used for login and saving spots to the database)
# https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (optional) YouTube検索結果のキャッシュを保持する秒数。未設定なら86400（24時間）。
SEARCH_CACHE_TTL_SECONDS=

# (optional) 検索キャッシュの書き込みをサーバー限定にしたい場合のみ設定
# （Project Settings -> API -> service_role key）。絶対に公開しないこと。
SUPABASE_SERVICE_ROLE_KEY=
